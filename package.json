{
  "name": "seragam-design-system",
  "version": "0.18.0",
  "description": "Token, komponen React, dokumentasi spesifikasi, dan Claude Skill untuk Design System Seragam (Kemendikdasmen)",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./css": "./tokens/seragam.css",
    "./tokens": "./tokens/seragam.tokens.json",
    "./docs/*": "./docs/*"
  },
  "files": [
    "src",
    "tokens",
    "docs",
    "skill",
    "skill-illustration",
    "examples",
    "tools"
  ],
  "scripts": {
    "build:tokens": "python3 tools/build_tokens.py $FIGMA_STYLES_JSON",
    "build:skill": "sh tools/build_skill.sh",
    "install:skill": "sh tools/build_skill.sh && mkdir -p ~/.claude/skills && ln -sfn \"$PWD/skill\" ~/.claude/skills/seragam && ln -sfn \"$PWD/skill-illustration\" ~/.claude/skills/seragam-illustration",
    "dev": "vite",
    "build:gallery": "vite build",
    "preview": "vite preview",
    "build:foundations": "python3 tools/build_foundations.py",
    "check": "python3 tools/check.py",
    "typecheck": "tsc -p .",
    "verify": "npm run check && npm run typecheck && vite build && npm run build:lib && npm run smoke:lib && playwright test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:lib": "vite build --config vite.pkg.config.ts && tsc -p tsconfig.pkg.json",
    "pack:release": "npm run build:lib && node tools/make-package.mjs",
    "smoke:lib": "node tools/smoke-package.mjs"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400",
    "react": ">=18",
    "tailwindcss": ">=4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "lucide-react": "^1.69.0",
    "marked": "^18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
